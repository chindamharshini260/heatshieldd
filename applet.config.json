{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "HeatShield AI",
  "version": "1.0.0",
  "description": "Comprehensive configuration and dependency specification for HeatShield AI biometeorological & heat health monitoring application",
  "runtime": {
    "engine": "node",
    "nodeVersion": ">=18.0.0",
    "port": 3000,
    "host": "0.0.0.0",
    "protocol": "http"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "setup": "npm install"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "features": [
    "Real-time Open-Meteo biometeorological data integration",
    "Personalized Heat & Thermal Strain (UTCI, WBGT, Heat Index) modeling",
    "Accurate GPS geolocation with high-accuracy live browser updates",
    "Spatial Municipal Microclimate & Ward Analytics for Indian metropolitan areas",
    "Actionable 5-Day Heat Impact Forecast & Hydration/Precaution Planners",
    "Offline/Cloud Persistence with Firebase Firestore authentication & user profile syncing"
  ],
  "permissions": [
    "geolocation"
  ],
  "environment": {
    "required": [],
    "optional": [
      "GEMINI_API_KEY"
    ]
  }
}
